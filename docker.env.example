# Copy to .env.docker. This example contains placeholders only.
APP_ENV=development
POSTGRES_DB=coffee_shop
POSTGRES_USER=coffee_app
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_RANDOM_VALUE
DATABASE_URL=postgresql+psycopg://coffee_app:CHANGE_ME_WITH_A_RANDOM_VALUE@db:5432/coffee_shop
JWT_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
CORS_ALLOWED_ORIGINS=
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Optional AI configuration; keep blank when AI is not used.
OPENAI_API_KEY=sk-ijklmnopqrstuvwxijklmnopqrstuvwxijklmnop
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=900

# Used only by: docker compose --profile demo run --rm demo-seed
DEMO_ADMIN_PASSWORD=CHANGE_ME_DEMO_PASSWORD_12_CHARS_MINIMUM
