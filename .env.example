# Copy to .env only when local configuration is needed.
APP_ENV=development
# Comma-separated browser origins. Keep empty when using a same-origin reverse proxy.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set this in the process environment or load your local .env manually.
# Use a dedicated development database; never point tests at production.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/coffee_shop_dev
# Generate a random key locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Server-side only. Never expose this value through VITE_* variables.
OPENAI_API_KEY=sk-ijklmnopqrstuvwxijklmnopqrstuvwxijklmnop
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=900

